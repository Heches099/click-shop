rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // --- Affiliate accounts ---
    // Read/write is scoped to the owning user. Anyone can create their own
    // account; only the owner can update it; no one may delete.
    match /affiliates/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // --- Click tracking ---
    // Public funnel: appending a click never requires an account. Read/update/
    // delete are closed so logs cannot be inspected or tampered with.
    match /clicks/{clickId} {
      allow create: if true
        && request.resource.data.keys().hasAll(['affiliateCode']);
      allow read, update, delete: if false;
    }

    // --- Commissions ---
    // Creation is checked against the creator's own uid and the referenced
    // affiliate id must be the creator's own, so users cannot mint
    // commissions for other affiliates. Read/update are owner-only.
    match /commissions/{commissionId} {
      allow read: if signedIn() && resource.data.affiliateId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.affiliateId == request.auth.uid;
      allow update: if signedIn() && resource.data.affiliateId == request.auth.uid;
      allow delete: if false;
    }
  }
}