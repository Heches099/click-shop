# ClickShop Backend configuration
# Copy to .env and adjust.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://clickshop:clickshop@localhost:5432/clickshop

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# --- Admin bootstrap ---
ADMIN_EMAIL=admin@clickshop.com
ADMIN_PASSWORD=ChangeMe123!

# --- Stripe (optional, dev works without it) ---
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- CORS ---
# Comma-separated list of allowed origins (the Flutter web origin).
CORS_ORIGINS=https://click-shop-d62ad.web.app,http://localhost:8080,http://localhost:3000,http://localhost:5173

# --- Misc ---
STORE_BASE_URL=https://clickshop.example.com
AFFILIATE_COMMISSION_RATE=0.10

# --- Amazon Associates / affiliate ---
# Affiliate-link mode is default and requires NO credentials.
# Keep AMAZON_API_ENABLED=false until the account is eligible for the
# Amazon Creators API / PA-API. Do NOT create AWS/IAM creds to bypass eligibility.
AMAZON_API_ENABLED=false
AMAZON_PARTNER_TAG=clickshop03b-20
AMAZON_MARKETPLACE=www.amazon.com
AMAZON_REGION=us-east-1

# Future Amazon API credentials — add ONLY when Amazon officially grants access.
# These must remain backend-only, never in Flutter/web client code.
# AMAZON_ACCESS_KEY=
# AMAZON_SECRET_KEY=
