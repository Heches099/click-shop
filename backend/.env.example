# ClickShop Backend configuration
# Copy to .env and adjust.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://clickshop:clickshop@localhost:5432/clickshop

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# --- Admin bootstrap ---
ADMIN_EMAIL=admin@clickshop.com
ADMIN_PASSWORD=ChangeMe123!

# --- Stripe (optional, dev works without it) ---
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- CORS ---
# Comma-separated list of allowed origins (the Flutter web origin).
CORS_ORIGINS=https://clickshop.example.com,http://localhost:8080,http://localhost:3000

# --- Misc ---
STORE_BASE_URL=https://clickshop.example.com
AFFILIATE_COMMISSION_RATE=0.10
